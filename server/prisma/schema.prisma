// Prisma Schema — Internship Diary (Elektron amaliyot kundaligi)
// Production-grade PostgreSQL schema with strict relations, indexes, and enums

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── ENUMS ────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  STUDENT
  COMPANY_SUPERVISOR
  UNIVERSITY_SUPERVISOR
}

enum InternshipStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DiaryEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
}

enum ReviewDecision {
  APPROVED
  RETURNED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  LATE
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
}

// ── MODELS ───────────────────────────────────────────────────────────────────

/// Core User entity
model User {
  id           String    @id @default(cuid())
  fullName     String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(STUDENT)
  isActive     Boolean   @default(true)
  phone        String?
  position     String?
  mustChangePassword Boolean @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // 1-to-1 Profile (for students)
  studentProfile StudentProfile?

  // 1-to-1 Telegram link
  telegramAccount TelegramAccount?
  telegramLinkTokens TelegramLinkToken[]

  // Relations as student / supervisors
  studentInternships              Internship[] @relation("StudentInternships")
  companySupervisorInternships    Internship[] @relation("CompanySupervisorInternships")
  universitySupervisorInternships Internship[] @relation("UniversitySupervisorInternships")

  // Relations for reviews and grades submitted by this user
  diaryReviews     DiaryReview[]
  internshipGrades InternshipGrade[]
  finalEvaluations FinalEvaluation[]

  @@index([role])
  @@index([isActive])
}

/// Profile information specific to Students
model StudentProfile {
  id            String       @id @default(cuid())
  userId        String       @unique
  studentNumber String       @unique
  groupId       String
  phone         String?

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  group StudentGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@index([groupId])
}

/// Academic study group (e.g., IT-210)
model StudentGroup {
  id           String           @id @default(cuid())
  name         String           @unique
  faculty      String
  studyProgram String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  students StudentProfile[]

  @@index([faculty])
}

/// Partner company / enterprise hosting internships
model Company {
  id           String       @id @default(cuid())
  name         String       @unique
  address      String
  contactPhone String?
  description  String?
  latitude     Float?
  longitude    Float?
  checkinRadius Int         @default(300)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  internships Internship[]

  @@index([name])
}

/// An internship agreement connecting student, company, and supervisors
model Internship {
  id                     String           @id @default(cuid())
  studentId              String
  companyId              String
  companySupervisorId    String?
  universitySupervisorId String?
  startDate              DateTime         @db.Date
  endDate                DateTime         @db.Date
  status                 InternshipStatus @default(ACTIVE)
  position               String?
  programDescription     String?          @db.Text
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  student              User  @relation("StudentInternships", fields: [studentId], references: [id], onDelete: Restrict)
  company              Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  companySupervisor    User? @relation("CompanySupervisorInternships", fields: [companySupervisorId], references: [id], onDelete: SetNull)
  universitySupervisor User? @relation("UniversitySupervisorInternships", fields: [universitySupervisorId], references: [id], onDelete: SetNull)

  diaryEntries DiaryEntry[]
  attendances  Attendance[]
  grades       InternshipGrade[]
  finalEvaluations FinalEvaluation[]
  planItems    InternshipPlanItem[]

  @@index([studentId])
  @@index([companyId])
  @@index([status])
  @@index([startDate, endDate])
}

/// Daily student diary entry
model DiaryEntry {
  id           String           @id @default(cuid())
  internshipId String
  entryDate    DateTime         @db.Date
  taskTitle    String
  description  String           @db.Text
  result       String?          @db.Text
  hours        Decimal          @default(8.0) @db.Decimal(4, 1)
  status       DiaryEntryStatus @default(DRAFT)
  planItemId   String?
  submittedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  planItem   InternshipPlanItem? @relation(fields: [planItemId], references: [id], onDelete: SetNull)

  attachments DiaryAttachment[]
  reviews     DiaryReview[]

  // Constraint: One daily entry per internship/date
  @@unique([internshipId, entryDate])
  @@index([internshipId])
  @@index([status])
  @@index([entryDate])
  @@index([planItemId])
}

/// Internship programme (plan) item: topic + planned hours. Diary entries link to it.
model InternshipPlanItem {
  id           String   @id @default(cuid())
  internshipId String
  orderIndex   Int      @default(0)
  title        String
  description  String?  @db.Text
  plannedHours Decimal  @default(8.0) @db.Decimal(5, 1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  internship   Internship   @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  diaryEntries DiaryEntry[]

  @@index([internshipId])
}

/// Attachments/evidence uploaded for a diary entry
model DiaryAttachment {
  id           String   @id @default(cuid())
  diaryEntryId String
  originalName String
  storedPath   String
  mimeType     String
  sizeBytes    BigInt
  createdAt    DateTime @default(now())

  diaryEntry DiaryEntry @relation(fields: [diaryEntryId], references: [id], onDelete: Cascade)

  @@index([diaryEntryId])
}

/// Feedback / Approval / Return review history for a diary entry
model DiaryReview {
  id           String         @id @default(cuid())
  diaryEntryId String
  reviewerId   String
  decision     ReviewDecision
  comment      String?        @db.Text
  createdAt    DateTime       @default(now())

  diaryEntry DiaryEntry @relation(fields: [diaryEntryId], references: [id], onDelete: Cascade)
  reviewer   User       @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([diaryEntryId])
  @@index([reviewerId])
}

/// Daily attendance tracking for an internship
model Attendance {
  id             String           @id @default(cuid())
  internshipId   String
  attendanceDate DateTime         @db.Date
  status         AttendanceStatus @default(PRESENT)
  hours          Decimal          @default(8.0) @db.Decimal(4, 1)
  note           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  // Prevent duplicate attendance records per internship/date
  @@unique([internshipId, attendanceDate])
  @@index([internshipId])
  @@index([attendanceDate])
}

/// Final evaluation / grade assigned to an internship
model InternshipGrade {
  id           String   @id @default(cuid())
  internshipId String
  reviewerId   String
  score        Decimal  @db.Decimal(5, 2) // e.g. 95.50
  comment      String?  @db.Text
  createdAt    DateTime @default(now())

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  reviewer   User       @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([internshipId])
  @@index([reviewerId])
}

/// Telegram account link for notification bot
model TelegramAccount {
  id             String   @id @default(cuid())
  userId         String   @unique
  telegramUserId BigInt   @unique
  username       String?
  linkedAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([telegramUserId])
}

/// One-time linking verification tokens for Telegram account binding
model TelegramLinkToken {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String   @unique
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Notification logs to ensure idempotency and auditing
model NotificationLog {
  id             String   @id @default(cuid())
  eventType      String
  entityId       String
  recipientId    String
  telegramUserId BigInt?
  status         String
  errorMessage   String?
  createdAt      DateTime @default(now())

  @@unique([eventType, entityId, recipientId])
  @@index([recipientId])
  @@index([eventType, entityId])
}

/// Final evaluation / grade assigned to an internship by a supervisor (Company or University)
model FinalEvaluation {
  id             String           @id @default(cuid())
  internshipId   String
  evaluatorId    String
  evaluatorRole  UserRole
  status         EvaluationStatus @default(DRAFT)
  totalScore     Decimal          @db.Decimal(5, 2)
  generalComment String?          @db.Text
  submittedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  internship     Internship       @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  evaluator      User             @relation(fields: [evaluatorId], references: [id], onDelete: Restrict)
  criteriaScores EvaluationCriteriaScore[]

  // Only one evaluation per supervisor role per internship (strict duplicate prevention)
  @@unique([internshipId, evaluatorRole])
  @@index([internshipId])
  @@index([evaluatorId])
  @@index([status])
}

/// Criterion-level score and feedback within a final evaluation
model EvaluationCriteriaScore {
  id           String          @id @default(cuid())
  evaluationId String
  criterionKey String
  score        Decimal         @db.Decimal(5, 2)
  comment      String?         @db.Text

  evaluation   FinalEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, criterionKey])
  @@index([evaluationId])
}
