# Server Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/internship_diary"

# Server port
PORT=3001

# Node environment: development | production | test
NODE_ENV=development

# CORS — comma-separated allowed origins
CORS_ORIGINS="http://localhost:5173"

# JWT Secret (generate a strong random secret in production, min 32 characters)
JWT_SECRET="your_strong_random_jwt_secret_min_32_chars"
JWT_EXPIRES_IN="7d"

# Client Web Application URL
CLIENT_URL="http://localhost:5173"

# Telegram Bot Integration (@amaliyot_kundaligibot)
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_FROM_BOTFATHER"
TELEGRAM_BOT_USERNAME="amaliyot_kundaligibot"

# Daily Telegram diary reminders (Asia/Tashkent hour); set REMINDERS_ENABLED=false to turn off
REMINDER_HOUR=18
REMINDERS_ENABLED=true

# Optional: custom Unicode TTF fonts for PDF reports (defaults: Arial on Windows, DejaVu on Linux)
# PDF_FONT_REGULAR=/path/to/font.ttf
# PDF_FONT_BOLD=/path/to/font-bold.ttf
