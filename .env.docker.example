# Copy to `.env` (next to docker-compose.yml) and fill in real values. Never commit `.env`.
POSTGRES_USER=amaliyot
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=internship_diary

# At least 16 random characters
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Public address of the app (used in QR codes on final reports and in Telegram links)
PUBLIC_URL=http://localhost:3001
APP_PORT=3001

# Optional: Telegram bot (leave empty to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=amaliyot_kundalik_uz_bot
# Hour (Asia/Tashkent) for daily diary reminders
REMINDER_HOUR=18
